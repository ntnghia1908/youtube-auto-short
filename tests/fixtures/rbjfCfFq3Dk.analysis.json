  },
  {
   "id": "s00293",
   "start": 1323.08,
   "end": 1326.38,
   "kind": "speech",
   "text": "gặp được duyên thì nó liền Khởi tác dụng"
  },
  {
   "id": "s00294",
   "start": 1326.38,
   "end": 1330.1,
   "kind": "speech",
   "text": "liền Khởi hiện hành"
  },
  {
   "id": "s00295",
   "start": 1331.12,
   "end": 1333.76,
   "kind": "speech",
   "text": "gặp Duyên liền xanh Khởi hiện tướng"
  },
  {
   "id": "s00296",
   "start": 1333.76,
   "end": 1338.02,
   "kind": "speech",
   "text": "chúng ta gọi là Thọ báo"
  },
  {
   "id": "s00297",
   "start": 1347.02,
   "end": 1350.419,
   "kind": "speech",
   "text": "trên kinh Phật nói giả sử Bách Thiên"
  },
  {
   "id": "s00298",
   "start": 1350.419,
   "end": 1352.059,
   "kind": "speech",
   "text": "Kiếp"
  },
  {
   "id": "s00299",
   "start": 1352.059,
   "end": 1356.36,
   "kind": "speech",
   "text": "sở tạo nghiệp bất công trong anh là giờ"
  },
  {
   "id": "s00809",
   "start": 3537.5,
   "end": 3540.38,
   "kind": "speech",
   "text": "ý nghĩa của đoạn văn này"
  },
  {
   "id": "s00810",
   "start": 3540.38,
   "end": 3542.42,
   "kind": "speech",
   "text": "thật là"
  },
  {
   "id": "s00811",
   "start": 3542.42,
   "end": 3547.5,
   "kind": "speech",
   "text": "sâu rộng vô cùng chúng ta phải rất tỉ mỉ"
  },
  {
   "id": "s00812",
   "start": 3547.5,
   "end": 3550.44,
   "kind": "speech",
   "text": "mà thể hội phải biết tu học như thế nào"
  },
  {
   "id": "s00813",
   "start": 3550.44,
   "end": 3552.66,
   "kind": "speech",
   "text": "hôm nay thời gian đã hết chúng ta chỉ"
  },
  {
   "id": "s00814",
   "start": 3552.66,
   "end": 3554.6,
   "kind": "speech",
   "text": "học đến nay thôi A Di Đà Phật"
  },
  {
   "id": "s00815",
   "start": 3554.6,
   "end": 3574.75,
   "kind": "non_speech",
   "text": "[âm nhạc]"
  },
  {
   "id": "s00816",
   "start": 3575.599,
   "end": 3577.22,
   "kind": "speech",
   "text": "gmail.com"
  },
  {
   "id": "s00817",
   "start": 3577.22,
   "end": 3580.099,
   "kind": "speech",
   "text": "người đọc Hạnh quang"
  },
  {
   "id": "s00818",
   "start": 3580.099,
   "end": 3583.2,
   "kind": "speech",
   "text": "phát âm cúng dường do gia đình Phật tử"
  },
  {
   "id": "s00819",
   "start": 3583.2,
   "end": 3586.68,
   "kind": "speech",
   "text": "Thiện Đức Thành kính cúng dường nguyện"
  },
  {
   "id": "s00820",
   "start": 3586.68,
   "end": 3590.099,
   "kind": "speech",
   "text": "cả thảy chúng sanh đều tính niệm Di Đà"
  },
  {
   "id": "s00821",
   "start": 3590.099,
   "end": 3594.359,
   "kind": "speech",
   "text": "Đồng cầu xanh về nước cực lạc miệng đem"
  },
  {
   "id": "s00822",
   "start": 3594.359,
   "end": 3597.119,
   "kind": "speech",
   "text": "công đức này Trang Nghiêm cõi nước Phật"
  },
  {
   "id": "s00823",
   "start": 3597.119,
   "end": 3601.44,
   "kind": "speech",
   "text": "trên nền 4 hên nặng dưới Cứu Khổ ba"
  },
  {
   "id": "s00824",
